<?xml version="1.0" encoding="utf-8"?>
<!--
    RemoteViews rather than Glance: a home-screen widget cannot host a real
    text field anyway, so this is a shortcut that looks like one, and a
    shortcut does not justify a new dependency in a project that has to
    account for every one of them at F-Droid review.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@string/widget_search_hint"
        android:src="@drawable/ic_widget_search" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_search_hint"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="16sp" />
</LinearLayout>
