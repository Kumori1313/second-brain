# Model weights — downloaded, never committed.
# Large binaries, and bundling weights in-repo muddies the license story
# (see the Non-Free Assets note in the roadmap). Fetch them per the
# Prerequisites section instead.
models/

# The vault. This is the author's own Obsidian vault, working-copy only —
# personal notes, never project content, and never committed.
#
# This comment previously described a cloned third-party fixture. That was
# wrong about what is actually in this directory, and the mistake propagated
# into the roadmap as a claim that Phase 1's exit criteria were unmet.
# If you are running this project, put your own vault here or point Loam
# somewhere else entirely — nothing in the build depends on this path.
Documents/

# Fixtures derived from the test vault — regenerable, and third-party derived
# for the same reason the vault itself isn't committed.
spike/app/src/test/resources/corpus_fixtures.json


# Android / Gradle
*.apk
*.aab
.gradle/
build/
local.properties
captures/
.cxx/

# Python venv for the fixture/verification tools. `python -m venv` writes a
# self-ignoring .gitignore inside, but don't rely on that.
.venv/

# Rust
target/
**/*.rs.bk

# IDE
.idea/
*.iml
.DS_Store
